{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citizen-bridge.local/contracts/events/user-events-v1.json",
  "title": "User event payload",
  "type": "object",
  "required": ["event_type", "user_id", "timestamp"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": ["user.registered", "user.profile_updated", "user.logged_in"]
    },
    "user_id": {"type": "string", "format": "uuid"},
    "username": {"type": "string"},
    "name": {"type": "string"},
    "city": {"type": "string"},
    "changed_fields": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "device_info": {"type": ["string", "null"]},
    "timestamp": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
