# Copy to .env on the production VM. Never commit the populated file.
JWT_SECRET=replace-with-openssl-rand-hex-32
INTERNAL_SERVICE_TOKEN=replace-with-openssl-rand-hex-32

POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
AUTH_DB_PASSWORD=replace-with-openssl-rand-hex-24
AUTHORITY_DB_PASSWORD=replace-with-openssl-rand-hex-24
CASE_DB_PASSWORD=replace-with-openssl-rand-hex-24
DOCUMENT_DB_PASSWORD=replace-with-openssl-rand-hex-24
NOTIFICATION_DB_PASSWORD=replace-with-openssl-rand-hex-24
CATALOG_DB_PASSWORD=replace-with-openssl-rand-hex-24
AI_DB_PASSWORD=replace-with-openssl-rand-hex-24

# Use a project-scoped production key. Do not paste it into source or Compose.
OPENAI_API_KEY=replace-with-openai-project-key
AI_MOCK_MODE=false
AI_INTAKE_MODEL=gpt-4o-mini
AI_REJECTION_MODEL=gpt-4o

# This project has no SMS provider yet. Set only for an explicitly approved demo.
OTP_DEMO_CODE=
DEMO_MODE=true
