# Copy to .env. These values are for local development only.

# Shared authentication secret (minimum 32 characters)
JWT_SECRET=dev-only-jwt-secret-change-before-production

# PostgreSQL administrator and schema-role passwords
POSTGRES_PASSWORD=dev-postgres-admin-password
AUTH_DB_PASSWORD=dev-auth-db-password
AUTHORITY_DB_PASSWORD=dev-authority-db-password
CASE_DB_PASSWORD=dev-case-db-password
DOCUMENT_DB_PASSWORD=dev-document-db-password
NOTIFICATION_DB_PASSWORD=dev-notification-db-password
CATALOG_DB_PASSWORD=dev-catalog-db-password
AI_DB_PASSWORD=dev-ai-db-password

# Gateway and exposed development ports
GATEWAY_PORT=8080
FRONTEND_PORT=3000
LEGACY_BACKEND_PORT=8000
POSTGRES_PORT=5432
KAFKA_PORT=29092
JAEGER_UI_PORT=16686
OTEL_GRPC_PORT=4317

# Service configuration
FRONTEND_URL=http://localhost:3000
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
AI_MOCK_MODE=true
ENABLE_WEBSOCKET=true

# Legacy application (kept during strangler transition)
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://legacy-backend:8000
LEGACY_DATABASE_URL=sqlite:///./data/citizen_bridge.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
MOCK_AI=true
DEMO_MODE=true
